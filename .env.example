# Configuração raiz para docker compose / backend / worker.
# Copie para .env e preencha os valores reais. Nunca commitar o .env real.

# --- Postgres ---
POSTGRES_DB=gerad
POSTGRES_USER=gerad
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://gerad:change-me@postgres:5432/gerad

# --- Redis (broker/result backend do Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Storage local (volume Docker) ---
STORAGE_DIR=/data/storage

# --- Identidade padrão do "CS" enquanto não há autenticação (ver plano, seção Context) ---
DEFAULT_CS_ID=cs-padrao
DEFAULT_CS_NAME=Consultor GerAD

# --- Upload ---
MAX_UPLOAD_MB=1024

# --- Celery (task do worker que roda transcrição + análise + relatórios) ---
TASK_TIME_LIMIT_SECONDS=3600
TASK_SOFT_TIME_LIMIT_SECONDS=3300

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Autenticação ---
# JWT_SECRET_KEY é obrigatório trocar em qualquer ambiente real (nunca usar o default de dev).
# COOKIE_SECURE deve ser true em qualquer deploy servido via HTTPS.
JWT_SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# Bootstrap do primeiro usuário ADMIN (rodar `python -m scripts.seed_admin` no container backend
# após o `alembic upgrade head`, ou via `docker compose exec backend python -m scripts.seed_admin`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# --- Motor gera_d_engine (repassado ao container backend/worker) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.2

# --- Assistente de IA (Fase 6) — modelo mais barato que o da engine, usado só no chat
# (reaproveita a mesma OPENAI_API_KEY acima) ---
ASSISTANT_CHAT_MODEL=gpt-6-luna
ASSISTANT_CHAT_TEMPERATURE=0.3
ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_DAILY_MESSAGE_LIMIT=30

# --- FinAI: observabilidade de custo de IA ---
# Preço por modelo, orçamento mensal e cotação do dólar NÃO ficam aqui: são editáveis pelo
# ADMIN na tela /custos-ia (tabelas ai_model_prices / ai_cost_budgets / ai_cost_settings).
# AI_COST_TRACKING_ENABLED=false desliga a captura inteira sem reverter código.
AI_COST_TRACKING_ENABLED=true
AI_COST_FFPROBE_TIMEOUT_SECONDS=60

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
