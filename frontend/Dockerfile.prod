# Imagem de PRODUÇÃO do SPA: o Vite gera os estáticos no build e o nginx os serve.
#
# Distinta de frontend/Dockerfile (que roda `npm run dev`) por dois motivos, nenhum deles
# cosmético: o dev server do Vite 8 recusa requisições cujo cabeçalho Host não seja
# localhost ("Blocked request. This host is not allowed"), então ele simplesmente não
# responde atrás de um domínio real; e servir TypeScript transformado on-the-fly custa
# muito mais CPU/RAM na VPS do que entregar arquivo estático.
#
# Esta imagem também é o nginx do stack: ela é o único ponto de entrada HTTP/HTTPS e faz
# proxy de /api/ para o backend. A configuração NÃO é copiada aqui — vem montada de
# deploy/nginx/templates (ver docker-compose.prod.yml), para que ajustar o servidor ou
# recarregar certificado não exija rebuild do bundle.

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# VITE_API_BASE_URL é inlinado no bundle pelo Vite em tempo de BUILD (`import.meta.env`),
# não lido em runtime: declará-lo em `environment:` no compose não teria efeito nenhum.
# É por isso que aqui ele é ARG e no compose aparece em `build.args`.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY . .
RUN npm run build

FROM nginx:alpine

# O default.conf da imagem é `default_server` na porta 80: deixá-lo responderia a
# requisições com Host desconhecido (varredura por IP, por exemplo) em vez de deixá-las
# cair no nosso server block.
RUN rm -f /etc/nginx/conf.d/default.conf

# O certbot renova o certificado no volume compartilhado sem avisar o nginx, que seguiria
# servindo da memória o certificado antigo até ele expirar de fato. Daí o loop de reload.
#
# Ele precisa ser um hook em /docker-entrypoint.d/ e NÃO um `command:` no compose: o
# docker-entrypoint.sh da imagem oficial só roda o envsubst dos templates quando o primeiro
# argumento é literalmente "nginx". Com `command: /bin/sh -c ...` a substituição é pulada em
# silêncio, /etc/nginx/conf.d/ fica vazio e o nginx sobe sem nenhum server block — inclusive
# com `nginx -t` passando, porque config vazia é config válida.
#
# O loop vai para background antes de o entrypoint dar `exec nginx`, então é reparentado
# para o master do nginx e sobrevive junto com ele.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'while :; do sleep 6h; nginx -s reload 2>/dev/null || true; done &' \
        > /docker-entrypoint.d/99-reload-para-renovacao-tls.sh \
    && chmod +x /docker-entrypoint.d/99-reload-para-renovacao-tls.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
