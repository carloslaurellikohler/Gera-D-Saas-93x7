DATABASE_URL=postgresql+psycopg://gerad:gerad@localhost:5432/gerad
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage_data
DEFAULT_CS_ID=cs-padrao
DEFAULT_CS_NAME=Consultor GerAD
MAX_UPLOAD_MB=100

# --- Autenticação ---
# JWT_SECRET_KEY é obrigatório trocar em qualquer ambiente real (nunca usar o default de dev).
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# COOKIE_SECURE deve ser true em qualquer deploy servido via HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Bootstrap do primeiro usuário ADMIN (rodar `python -m scripts.seed_admin` após o `alembic upgrade head`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# Config da engine (gera_d_engine) — repassada via ambiente, não via engine/.env
# (ver README raiz, seção sobre descoberta de .env da engine ser sensível ao contexto de import).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.2
